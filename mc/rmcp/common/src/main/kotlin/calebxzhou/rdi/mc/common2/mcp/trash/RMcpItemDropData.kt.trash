package calebxzhou.rdi.mc.common2.mcp.trash

import calebxzhou.rdi.mc.common2.mcp.model.EntityPos

@JvmRecord
data class RMcpItemDropData(
    val code: String,
    val from: String,
    val dryRun: Boolean,
    val changed: Boolean,
    val requestedCount: Int,
    val droppedCount: Int,
    val beforeItem: RMcpInventoryData.Item,
    val afterItem: RMcpInventoryData.Item,
    val entity: DroppedEntity,
    val inventory: RMcpInventoryData?
) {
    @JvmRecord
    data class DroppedEntity(
        val uuid: String,
        val itemId: String,
        val count: Int,
        val snbt: String,
        val pos: EntityPos?
    )
}
