package calebxzhou.rdi.mc.common2.mcp.trash

@JvmRecord
data class RMcpItemPickupData(
    val requestedCount: Int,
    val pickedCount: Int,
    val failedCount: Int,
    val results: List<Result>,
    val inventory: RMcpInventoryData?
) {
    @JvmRecord
    data class Result(
        val id: String,
        val code: String,
        val picked: Boolean,
        val pickedCount: Int,
        val beforeItem: String,
        val remainingItem: String,
        val motionSqr: Double,
        val distance: Double
    )
}
