package calebxzhou.rdi.mc.common2.mcp.trash

@JvmRecord
data class RMcpItemDropRequest(
    val from: String,
    val count: Int,
    val pos: Pos,
    val pickupDelay: Int,
    val dryRun: Boolean
) {
    @JvmRecord
    data class Pos(
        val x: Double,
        val y: Double,
        val z: Double?
    )
}
