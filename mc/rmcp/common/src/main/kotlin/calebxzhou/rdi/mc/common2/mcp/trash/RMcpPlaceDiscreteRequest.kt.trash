package calebxzhou.rdi.mc.common2.mcp.trash

import calebxzhou.rdi.mc.common2.mcp.model.RBlockPos

@JvmRecord
data class RMcpPlaceDiscreteRequest(
    val blockId: String,
    val targets: List<Target>,
    val dryRun: Boolean
) {
    @JvmRecord
    data class Target(
        val pos: RBlockPos,
        val state: Map<String, String>?
    )
}
