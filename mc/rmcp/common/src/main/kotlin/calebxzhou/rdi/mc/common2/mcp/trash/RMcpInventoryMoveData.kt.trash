package calebxzhou.rdi.mc.common2.mcp.trash

@JvmRecord
data class RMcpInventoryMoveData(
    val from: String,
    val to: String,
    val count: Int,
    val dryRun: Boolean,
    val changed: Boolean,
    val movedCount: Int,
    val beforeFrom: RMcpInventoryData.Item,
    val beforeTo: RMcpInventoryData.Item,
    val afterFrom: RMcpInventoryData.Item,
    val afterTo: RMcpInventoryData.Item,
    val inventory: RMcpInventoryData?
)
