package calebxzhou.rdi.mc.common2.mcp.trash

@JvmRecord
data class RMcpInventoryTagMatchData(
    val tag: String,
    val scope: String,
    val containerOpen: Boolean,
    val totalCount: Int,
    val matchCount: Int,
    val matches: List<Match>
) {
    @JvmRecord
    data class Match(
        val source: String,
        val area: String,
        val slot: Int,
        val menuSlot: Int,
        val item: RMcpInventoryData.Item?
    )
}

