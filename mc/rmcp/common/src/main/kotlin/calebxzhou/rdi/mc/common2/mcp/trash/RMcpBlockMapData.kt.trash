package calebxzhou.rdi.mc.common2.mcp.trash

import calebxzhou.rdi.mc.common2.mcp.model.RBlockPos

@JvmRecord
data class RMcpBlockMapData(
    val dim: String,
    val mode: String,
    val center: RBlockPos,
    val radius: Int,
    val axes: Axes,
    val y: Int?,
    val scanY: RMcpSectionSemanticData.BlockYRange?,
    val summary: Summary,
    val legend: Map<String, String>,
    val rows: List<String>,
    val cells: List<Cell>
) {
    @JvmRecord
    data class Axes(val rows: String, val cols: String, val origin: String?)

    @JvmRecord
    data class Summary(
        val width: Int,
        val height: Int,
        val loadedChunks: Int,
        val walkable: Int,
        val blocked: Int,
        val hazards: Int,
        val fluids: Int,
        val drops: Int,
        val topBlocks: List<RMcpSectionSemanticData.BlockCount>
    )

    @JvmRecord
    data class Cell(
        val pos: RBlockPos,
        val symbol: String,
        val blockId: String,
        val floorBlockId: String,
        val note: String?
    )
}
