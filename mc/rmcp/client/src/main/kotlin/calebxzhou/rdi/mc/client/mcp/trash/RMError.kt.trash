package calebxzhou.rdi.mc.client.mcp.trash

import calebxzhou.rdi.mc.common2.mcp.RErrorCode

/**
 * calebxzhou @ 2026-05-10 12:26
 *
 * Exception that wraps an [RErrorCode] and exposes its id as the exception message.
 *
 * @property errorCode the error code associated with this error
 */
@Deprecated("no use")
open class RMError(
    val errorCode: RErrorCode
) : Exception(errorCode.id) {

    constructor(errorCode: RErrorCode, cause: Throwable) : this(errorCode) {
        initCause(cause)
    }

    /**
     * The error code id string.
     */
    val code: String
        get() = errorCode.id
}
