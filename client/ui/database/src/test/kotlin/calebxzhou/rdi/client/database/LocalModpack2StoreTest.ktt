package calebxzhou.rdi.client.database

import app.cash.sqldelight.driver.jdbc.sqlite.JdbcSqliteDriver
import calebxzau.rdi.common.model.ContentPlatform
import calebxzau.rdi.common.model.ContentSide
import calebxzau.rdi.common.model.ContentType
import calebxzhou.rdi.common.model.McVersion
import calebxzhou.rdi.common.model.ModLoader
import kotlinx.coroutines.runBlocking
import java.nio.file.Files
import kotlin.test.Test
import kotlin.test.assertEquals
import kotlin.test.assertFailsWith
import kotlin.test.assertNull
import kotlin.test.assertTrue
import kotlin.uuid.Uuid

class LocalModpack2StoreTest {
    @Test
    fun `fresh schema has only remote instance and cache tables`() = runBlocking {
        val file = Files.createTempDirectory("rdi-local-modpack2-fresh").resolve("data.db")
        MinecraftInstallationDatabase.open(file).getOrThrow().use { database ->
            val instance = instance()
            database.localModpack2Store.upsert(instance).getOrThrow()
            assertEquals(instance, database.localModpack2Store.find(instance.versionId).getOrThrow())
            val cache = cache(instance.versionId)
            database.localModpack2Store.replaceContentCache(instance.versionId, listOf(cache)).getOrThrow()
            assertEquals(listOf(cache), database.localModpack2Store.listContentCache(instance.versionId).getOrThrow())
            database.localModpack2Store.replaceContentCache(instance.versionId, emptyList()).getOrThrow()
            assertTrue(database.localModpack2Store.listContentCache(instance.versionId).getOrThrow().isEmpty())
        }
        assertEquals(13L, readUserVersion(file))
        assertTrue(tableExists(file, "local_modpack2_instance"))
        assertTrue(tableExists(file, "local_modpack2_content_cache"))
        listOf(
            "local_modpack2_content", "local_modpack2_content_override", "local_modpack2_content_dependency",
            "local_modpack2_unknown_file", "local_modpack2_submission",
        ).forEach { assertTrue(!tableExists(file, it), "obsolete table remains: $it") }
    }

    @Test
    fun `instance identity is required and must equal remote version`() = runBlocking {
        val file = Files.createTempDirectory("rdi-local-modpack2-identity").resolve("data.db")
        MinecraftInstallationDatabase.open(file).getOrThrow().use { database ->
            val id = uuid("019f2d68-6b7e-7ec8-98d1-0b8483c39875")
            assertFailsWith<IllegalArgumentException> {
                LocalModpack2InstanceRecord(id, remoteVersionId = uuid("019f2d68-6b7e-7ec8-98d1-0b8483c39876"), name = "bad", mcVersion = McVersion.V211, modLoader = ModLoader.neoforge, updatedAt = 1L)
            }
            assertFailsWith<IllegalArgumentException> {
                database.localModpack2Store.upsert(instance(id).copy(remoteVersionId = uuid("019f2d68-6b7e-7ec8-98d1-0b8483c39876"))).getOrThrow()
            }
        }
    }

    @Test
    fun `schema twelve migration keeps valid remote rows and linked cache only`() = runBlocking {
        val file = Files.createTempDirectory("rdi-local-modpack2-migration").resolve("data.db")
        MinecraftInstallationDatabase.open(file).getOrThrow().close()
        createSchemaTwelveFixture(file)

        MinecraftInstallationDatabase.open(file).getOrThrow().use { database ->
            val store = database.localModpack2Store
            val valid = uuid("019f2d68-6b7e-7ec8-98d1-0b8483c39875")
            assertEquals(listOf(valid), store.list().getOrThrow().map { it.versionId })
            assertEquals(1, store.listContentCache(valid).getOrThrow().size)
            assertNull(store.find(uuid("019f2d68-6b7e-7ec8-98d1-0b8483c39876")).getOrThrow())
            assertEquals(13L, readUserVersion(file))
        }
    }

    @Test
    fun `foreign keys are enabled and delete cascades disposable cache`() = runBlocking {
        val file = Files.createTempDirectory("rdi-local-modpack2-cascade").resolve("data.db")
        MinecraftInstallationDatabase.open(file).getOrThrow().use { database ->
            assertTrue(database.foreignKeysEnabled())
            val record = instance()
            database.localModpack2Store.upsert(record).getOrThrow()
            database.localModpack2Store.replaceContentCache(record.versionId, listOf(cache(record.versionId))).getOrThrow()
            database.localModpack2Store.delete(record.versionId).getOrThrow()
            assertTrue(database.localModpack2Store.listContentCache(record.versionId).getOrThrow().isEmpty())
        }
    }

    private fun instance(id: Uuid = uuid("019f2d68-6b7e-7ec8-98d1-0b8483c39875")) = LocalModpack2InstanceRecord(
        versionId = id,
        remoteModpackId = uuid("019f2d68-6b7e-7ec8-98d1-0b8483c39877"),
        remoteVersionId = id,
        name = "远程整合包",
        comment = "comment",
        mcVersion = McVersion.V211,
        modLoader = ModLoader.neoforge,
        updatedAt = 1L,
    )

    private fun cache(versionId: Uuid) = LocalModpack2ContentCacheRecord(
        versionId = versionId,
        contentType = ContentType.Mod,
        physicalPath = "mods/example.jar",
        targetPath = "mods/example.jar",
        enabled = true,
        hash = "0123456789abcdef",
        fileSize = 42L,
        modIds = listOf("example"),
        sideHints = setOf(ContentSide.Both),
        platform = ContentPlatform.Modrinth,
        projectId = "project",
        fileId = "file",
        slug = "example",
        side = ContentSide.Both,
        required = true,
        updatedAt = 2L,
    )

    private fun createSchemaTwelveFixture(file: java.nio.file.Path) {
        JdbcSqliteDriver("jdbc:sqlite:${file.toUri()}").use { driver ->
            driver.execute(null, "PRAGMA foreign_keys = OFF", 0)
            listOf(
                "local_modpack2_content_dependency", "local_modpack2_content_override", "local_modpack2_unknown_file",
                "local_modpack2_submission", "local_modpack2_content", "local_modpack2_content_cache", "local_modpack2_instance",
            ).forEach { driver.execute(null, "DROP TABLE IF EXISTS $it", 0) }
            driver.execute(null, "PRAGMA application_id = 0x524449", 0)
            driver.execute(null, "CREATE TABLE local_modpack2_instance(version_id TEXT NOT NULL PRIMARY KEY, kind TEXT NOT NULL, remote_modpack_id TEXT, remote_version_id TEXT, source_modpack_id TEXT, source_version_id TEXT, base_version_id TEXT, publish_status TEXT NOT NULL, name TEXT NOT NULL, comment TEXT, icon_url TEXT, mc_version TEXT NOT NULL, mod_loader TEXT NOT NULL, local_revision INTEGER NOT NULL DEFAULT 0, published_revision INTEGER NOT NULL DEFAULT 0, updated_at INTEGER NOT NULL)", 0)
            driver.execute(null, "CREATE TABLE local_modpack2_content_cache(version_id TEXT NOT NULL, content_type TEXT NOT NULL, physical_path TEXT NOT NULL, target_path TEXT NOT NULL, enabled INTEGER NOT NULL, hash TEXT NOT NULL, file_size INTEGER NOT NULL, mod_ids TEXT NOT NULL, side_hints TEXT NOT NULL, name TEXT, icon_path TEXT, platform TEXT, project_id TEXT, file_id TEXT, slug TEXT, side TEXT, required INTEGER, updated_at INTEGER NOT NULL, PRIMARY KEY(version_id, content_type, physical_path))", 0)
            listOf("local_modpack2_content_dependency", "local_modpack2_content_override", "local_modpack2_unknown_file", "local_modpack2_submission", "local_modpack2_content").forEach { driver.execute(null, "CREATE TABLE $it(version_id TEXT)", 0) }
            val valid = "019f2d68-6b7e-7ec8-98d1-0b8483c39875"
            val modpack = "019f2d68-6b7e-7ec8-98d1-0b8483c39877"
            driver.execute(null, "INSERT INTO local_modpack2_instance VALUES ('$valid','Installed','$modpack','$valid',NULL,NULL,NULL,'Ok','valid',NULL,NULL,'V211','neoforge',0,0,1)", 0)
            driver.execute(null, "INSERT INTO local_modpack2_content_cache VALUES ('$valid','Mod','mods/example.jar','mods/example.jar',1,'hash',42,'example','Both','example',NULL,'Modrinth','project','file','example','Both',1,2)", 0)
            driver.execute(null, "INSERT INTO local_modpack2_instance VALUES ('019f2d68-6b7e-7ec8-98d1-0b8483c39876','Installed',NULL,'019f2d68-6b7e-7ec8-98d1-0b8483c39876',NULL,NULL,NULL,'Ok','missing',NULL,NULL,'V211','neoforge',0,0,1)", 0)
            driver.execute(null, "INSERT INTO local_modpack2_instance VALUES ('bad','Workspace','$modpack','bad',NULL,NULL,NULL,'Draft','malformed',NULL,NULL,'V211','neoforge',0,0,1)", 0)
            driver.execute(null, "PRAGMA user_version = 12", 0)
        }
    }

    private fun uuid(value: String): Uuid = Uuid.parse(value)
    private fun readUserVersion(file: java.nio.file.Path): Long = JdbcSqliteDriver("jdbc:sqlite:${file.toUri()}").use { driver -> driver.executeQuery(null, "PRAGMA user_version", { cursor -> app.cash.sqldelight.db.QueryResult.Value(if (cursor.next().value) cursor.getLong(0) ?: 0L else 0L) }, 0).value }
    private fun tableExists(file: java.nio.file.Path, table: String): Boolean = JdbcSqliteDriver("jdbc:sqlite:${file.toUri()}").use { driver -> driver.executeQuery(null, "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = '$table'", { cursor -> app.cash.sqldelight.db.QueryResult.Value(cursor.next().value) }, 0).value }
}
