private val lgr by Loggers

data class Modpack2InstallState(
    val scanning: Boolean = true,
    val candidates: List<LocalModpackCandidate> = emptyList(),
    val scanError: String? = null,
    val archiveLoading: Boolean = false,
    val archiveError: String? = null,
    val editor: Modpack2InstallEditorState? = null,
)

data class Modpack2InstallEditorState(
    val source: Modpack2WorkspaceSource?,
    val mcVersion: McVersion,
    val modLoader: ModLoader,
    val name: String,
    val comment: String = "",
    val iconUrl: String = "",
    val submitting: Boolean = false,
    val error: String? = null,
    val resolvedMods: Map<String, ResolvedArchiveMod> = emptyMap(),
    val contentResolving: Boolean = false,
    val archivePath: Path? = null,
    val archivePreviewLoading: Boolean = false,
    val archiveProgress: ModpackArchiveReadProgress? = null,
) {
    val canSubmit: Boolean
        get() = source != null && !archivePreviewLoading && !contentResolving && !submitting
}

data class Modpack2InstallStarted(val runId: String)

fun interface Modpack2InstallTaskSubmitter {
    fun submit(task: Task2, dedupeKey: String): String
}

private object ClientModpack2InstallTaskSubmitter : Modpack2InstallTaskSubmitter {
    override fun submit(task: Task2, dedupeKey: String): String = ClientTaskManager.submit(task, dedupeKey)
}

class Modpack2InstallViewModel(
    private val scanner: LocalModpackScanner,
    private val service: Modpack2LocalService,
    private val archiveReader: calebxzhou.rdi.client.service.ModpackArchiveReader,
    private val contentResolver: ModpackArchiveContentResolutionSource,
    private val taskSubmitter: Modpack2InstallTaskSubmitter = ClientModpack2InstallTaskSubmitter,
) : ViewModel() {
    private val mutableState = MutableStateFlow(Modpack2InstallState())
    private val eventChannel = Channel<Modpack2InstallStarted>(Channel.BUFFERED)
    private var archiveLoadJob: Job? = null
    private var archiveGeneration = 0L
    private val resolutionCache = mutableMapOf<ArchiveIdentity, ResolutionCache>()

    val state: StateFlow<Modpack2InstallState> = mutableState.asStateFlow()
    val events = eventChannel.receiveAsFlow()

