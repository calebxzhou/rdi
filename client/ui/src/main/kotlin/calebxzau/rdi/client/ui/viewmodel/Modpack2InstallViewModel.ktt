        mutableState.update { it.copy(scanning = false, archiveLoading = false, scanError = "入口已移除，请从上传页选择平台安装包", archiveError = "入口已移除，请从上传页选择平台安装包", editor = it.editor?.copy(error = "入口已移除，请从上传页选择平台安装包")) }
