    fun setVersionName(value: String) = _uiState.update { it.copy(versionName = value, errorMessage = null) }

    fun setIntro(value: String) = _uiState.update { it.copy(intro = value, errorMessage = null) }

    fun setIconUrl(value: String) = _uiState.update { it.copy(iconUrl = value, errorMessage = null) }

    fun toggleCategory(category: ModpackCategory) {
        _uiState.update { state ->
            when {
                category in state.categories && state.categories.size == 1 ->
                    state.copy(errorMessage = "至少选择1个分类")
                category in state.categories ->
                    state.copy(
                        categories = state.categories.filterNot { it == category },
                        errorMessage = null,
                    )
                state.categories.size >= Modpack.MAX_CATEGORY_COUNT ->
                    state.copy(errorMessage = "最多选择${Modpack.MAX_CATEGORY_COUNT}个分类")
                else ->
                    state.copy(categories = state.categories + category, errorMessage = null)
            }
        }
    }

    fun setChangelog(value: String) = _uiState.update { it.copy(changelog = value, errorMessage = null) }

    fun setServerMode(value: Modpack2ServerMode) = _uiState.update { it.copy(serverMode = value, errorMessage = null) }

    fun setProvidedServerPack(value: java.nio.file.Path) =
        _uiState.update { it.copy(providedServerPack = value, errorMessage = null) }

    fun setContentSide(path: String, side: ContentSide) {
        _uiState.update { state ->
            state.copy(
                manualSideOverrides = state.manualSideOverrides + ("path:${normalizePublishPath(path)}" to side),
                errorMessage = null,
            )
        }
    }

    fun rescan() {
        _uiState.update { it.copy(errorMessage = "入口已移除，请从上传页选择平台安装包") }
    }

    /** Returns true only for the exact desktop Home key event. */
    fun handleKey(type: KeyEventType, key: Key): Boolean {
        if (!isExactModpackTestBypassKey(type, key)) return false
        _uiState.update { it.copy(errorMessage = "入口已移除，请从上传页选择平台安装包") }
        return true
    }

