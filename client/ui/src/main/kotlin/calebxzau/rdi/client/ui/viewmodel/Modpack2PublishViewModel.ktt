            it.copy(
                submittedRunId = runId,
                contentEditingFrozen = false,
                errorMessage = null,
            )
        }
        return runId
    } */
    }

    fun retry(): String? {
        _uiState.update { it.copy(errorMessage = "入口已移除，请从上传页选择平台安装包") }
        return null
    }

    fun abandon() {
        _uiState.update { it.copy(errorMessage = "入口已移除，请从上传页选择平台安装包") }
    }

    private fun buildPublishRequest(
        state: Modpack2PublishUiState,
        local: LocalModpack2InstanceRecord,
    ) = Modpack2PublishRequest(
            localVersionId = local.versionId,
            modpackId = state.publishModpackId,
            baseVersionId = state.baseVersionId,
            versionName = state.versionName.trim(),
            changelog = state.changelog,
            serverMode = state.serverMode,
            providedServerPack = state.providedServerPack,
            manualSideOverrides = state.manualSideOverrides + buildModpack2ManualSideOverrides(state.contents),
            modpack = if (state.publishModpackId == null) {
                Modpack2CreateModpackDto(
                    name = local.name,
                    intro = state.intro,
                    mc = local.mcVersion.vMinor.toInt(),
                    loader = local.modLoader.toModpack2Loader(),
                    iconUrl = state.iconUrl.trim(),
                    categories = state.categories.distinct(),
                )
            } else null,
        )
}

internal fun reduceModpack2RescanCompletion(
    state: Modpack2PublishUiState,
    status: Task2Status,
    errorMessage: String?,
): Modpack2PublishUiState = state.copy(
    contentEditingFrozen = false,
    errorMessage = if (status == Task2Status.DONE) null else errorMessage ?: "扫描失败",
)

internal fun buildModpack2ManualSideOverrides(
    contents: List<LocalModpack2ContentRecord>,
): Map<String, ContentSide> = buildMap {
    contents.filter { it.manualSide != null }.forEach { content ->
        val side = content.manualSide ?: return@forEach
        content.targetPath?.takeIf(String::isNotBlank)?.let { path -> put("path:${normalizePublishPath(path)}", side) }
    }
}

internal fun normalizePublishPath(path: String): String = path.replace('\\', '/').trimStart('/')

internal fun missingPublishSideSelection(state: Modpack2PublishUiState): String? {
    val knownByPath = state.contents.filter { it.enabled }.mapNotNull { record ->
        record.targetPath?.let { normalizePublishPath(it) to record }
    }.toMap()
    return state.diskItems.firstOrNull { item ->
        if (!item.enabled || item.type != ContentType.Mod) return@firstOrNull false
        val key = "path:${normalizePublishPath(item.targetPath)}"
        if (key in state.manualSideOverrides) return@firstOrNull false
        if (item.sideHints.size == 1) return@firstOrNull false
        val known = knownByPath[normalizePublishPath(item.targetPath)]
        known == null
    }?.displayName
}

/** Compose exposes Home as MoveHome on desktop; no other key is accepted here. */
internal fun isExactModpackTestBypassKey(type: KeyEventType, key: Key): Boolean =
    type == KeyEventType.KeyDown && key == Key.MoveHome

internal fun validateModpack2CreateMetadata(
    intro: String,
    iconUrl: String,
    categories: List<ModpackCategory>,
    name: String? = null,
    version: String? = null,
): Result<Unit> = runCatching {
    fun validateText(value: String, label: String, max: Int) {
        require(value.none(Char::isISOControl)) { "${label}不能包含控制字符" }
        val count = value.codePointCount(0, value.length)
        require(count in 1..max) { "${label}长度必须为1~${max}个字符" }
    }
    name?.let { validateText(it.trim(), "整合包名称", 64) }
    version?.let {
        val normalized = it.trim().removePrefix("v").removePrefix("V").trimStart()
        validateText(normalized, "版本名称", 32)
    }
    val normalizedIntro = intro.trim()
    require(normalizedIntro.none(Char::isISOControl)) { "简介不能包含控制字符" }
    val introLength = normalizedIntro.modpackInfoCharacterCount()
    require(introLength in MODPACK_INFO_MIN_CHARACTERS..MODPACK_INFO_MAX_CHARACTERS) {
        "简介长度必须为${MODPACK_INFO_MIN_CHARACTERS}~${MODPACK_INFO_MAX_CHARACTERS}个字符"
    }
    val normalizedIconUrl = iconUrl.trim()
    require(normalizedIconUrl.isNotBlank()) { "图标链接不能为空" }
    require(normalizedIconUrl.none(Char::isISOControl) && normalizedIconUrl.codePointCount(0, normalizedIconUrl.length) <= 2048) {
        "图标链接长度无效"
    }
    val iconUri = normalizedIconUrl.validateHttpUrl().getOrThrow()
    require(!iconUri.host.isNullOrBlank()) { "图标链接必须包含有效主机" }
    val distinctCategories = categories.distinct()
    require(distinctCategories.size in 1..Modpack.MAX_CATEGORY_COUNT) {
        "分类数量须在1到${Modpack.MAX_CATEGORY_COUNT}个"
    }
}

internal fun reduceModpack2PublishKey(
    state: Modpack2PublishUiState,
    type: KeyEventType,
    key: Key,
): Modpack2PublishUiState = state.takeIf { !isExactModpackTestBypassKey(type, key) }
    ?: state.copy(ignoreModpackTest = true)

private fun Modpack2DiskContentUnit.toContentGridItem(known: List<LocalModpack2ContentRecord>): ContentGridItem.ContentItem {
    val path = targetPath
    val record = known.firstOrNull { it.targetPath == targetPath && it.hash.equals(hash, true) }
    return ContentGridItem.ContentItem(
        key = path,
        type = when (type) {
            ContentType.Mod -> ContentGridType.MOD
            ContentType.ResPack -> ContentGridType.RESOURCE_PACK
            ContentType.ShaderPack -> ContentGridType.SHADER_PACK
            ContentType.DataPack -> ContentGridType.DATA_PACK
            ContentType.Other -> ContentGridType.OTHER
        },
        name = record?.slug?.ifBlank { null } ?: displayName,
        fileName = path.substringAfterLast('/'),
        targetPath = path,
        required = record?.required ?: false,
        status = record?.let { "${it.platform.name} · ${it.side.name}" } ?: "未识别 · ${if (sideHints.isEmpty()) "请选择运行侧" else "可推断运行侧"}",
    )
}

private fun LocalModpack2ContentRecord.toContentGridItem(): ContentGridItem.ContentItem {
    val path = targetPath.orEmpty().ifBlank { slug }
    return ContentGridItem.ContentItem(
        key = contentId.toString(),
        type = when (type) {
            ContentType.Mod -> ContentGridType.MOD
            ContentType.ResPack -> ContentGridType.RESOURCE_PACK
            ContentType.ShaderPack -> ContentGridType.SHADER_PACK
            ContentType.DataPack -> ContentGridType.DATA_PACK
            ContentType.Other -> ContentGridType.OTHER
        },
        name = slug.ifBlank { path.substringAfterLast('/') },
        fileName = path.substringAfterLast('/'),
        targetPath = path,
        required = required,
        status = "${platform.name} · ${side.name}",
    )
}

private fun calebxzhou.rdi.common.model.ModLoader.toModpack2Loader(): Modpack2Loader = when (this) {
    calebxzhou.rdi.common.model.ModLoader.neoforge -> Modpack2Loader.NeoForge
    else -> Modpack2Loader.Forge
}
