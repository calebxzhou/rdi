data class Modpack2PublishUiState(
    val loading: Boolean = true,
    val local: LocalModpack2InstanceRecord? = null,
    val submission: LocalModpack2SubmissionRecord? = null,
    /** Parent id resolved from a copied Installed record when the workspace row is local-only. */
    val publishModpackId: Uuid? = null,
    val contents: List<LocalModpack2ContentRecord> = emptyList(),
    val contentItems: List<ContentGridItem> = emptyList(),
    val diskItems: List<Modpack2DiskContentUnit> = emptyList(),
    val manualSideOverrides: Map<String, ContentSide> = emptyMap(),
    val versionName: String = "",
    val intro: String = "",
    val iconUrl: String = "",
    val categories: List<ModpackCategory> = listOf(ModpackCategory.Other),
    val changelog: String = "",
    val serverMode: Modpack2ServerMode = Modpack2ServerMode.Generated,
    val providedServerPack: java.nio.file.Path? = null,
    val baseVersionId: Uuid? = null,
    val ignoreModpackTest: Boolean = false,
    val contentEditingFrozen: Boolean = false,
    val submittedRunId: String? = null,
    val errorMessage: String? = null,
)

/** State and intent boundary for the four-part Modpack2 publish form. */
