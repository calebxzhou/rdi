package calebxzhou.rdi.client.service

import calebxzau.rdi.common.model.ContentType

internal val MODPACK2_CONTENT_ROOTS = listOf("mods", "resourcepacks", "shaderpacks")

internal fun modpack2ContentType(root: String): ContentType? = when (root.lowercase()) {
    "mods" -> ContentType.Mod
    "resourcepacks" -> ContentType.ResPack
    "shaderpacks" -> ContentType.ShaderPack
    else -> null
}

internal fun isModpack2DisabledPath(path: String): Boolean {
    val normalized = path.replace('\\', '/').trimStart('/')
    return normalized == ".rdi/disabled" || normalized.startsWith(".rdi/disabled/")
}

internal fun modpack2DisabledRelativePath(root: String, itemName: String): String =
    normalizeModpack2Path(".rdi/disabled/$root/$itemName")

/** Paths which are generated by Minecraft/the launcher and are not pack content. */
internal fun isModpack2RuntimePath(path: String): Boolean {
    val normalized = path.replace('\\', '/').trimStart('/')
    if (normalized.isBlank()) return false
    val topLevel = normalized.substringBefore('/')
    val fileName = normalized.substringAfterLast('/')
    return normalized == ".rdi" || normalized.startsWith(".rdi/") ||
        topLevel in setOf("logs", "crash-reports", "screenshots", "saves", "world", "playerdata", "libraries") ||
        fileName in setOf("options.txt", "servers.dat", "eula.txt", "server.properties") ||
        normalized.endsWith(".installing") || normalized.contains("/.tmp-")
}

/** Normalizes and validates a raw-file path before it is used as a local relative path. */
internal fun normalizeModpack2Path(path: String): String {
    val raw = path.replace('\\', '/')
    require(!raw.startsWith('/') && !raw.matches(Regex("^[A-Za-z]:/.*"))) { "整合包路径必须是相对路径: $path" }
    val normalized = raw.removePrefix("./")
    require(normalized.isNotBlank() && normalized.none(Char::isISOControl)) { "整合包路径非法: $path" }
    val segments = normalized.split('/')
    require(segments.none { it.isBlank() || it == "." || it == ".." }) { "整合包路径非法: $path" }
    return segments.joinToString("/")
}

/** Only the three player-managed content roots participate in reconciliation/unknown state. */
internal fun isModpack2ManagedContentPath(path: String): Boolean {
    val normalized = path.replace('\\', '/').trimStart('/')
    return normalized.substringBefore('/') in setOf("mods", "resourcepacks", "shaderpacks")
}
