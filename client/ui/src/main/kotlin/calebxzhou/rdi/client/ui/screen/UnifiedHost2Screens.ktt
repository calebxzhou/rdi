@Composable
fun UnifiedHost2InfoScreen(
    target: HostTarget,
    onBack: () -> Unit,
    onOpenPlay: ((McPlayArgs) -> Unit)? = null,
    onOpenModpackInfo: (String) -> Unit = {},
    onOpenTaskList: (String) -> Unit = {},
) {
    val hostId = target.id
    val scope = rememberCoroutineScope()
    var detail by remember(hostId) { mutableStateOf<Host2.DetailVo?>(null) }
    var message by remember(hostId) { mutableStateOf<String?>(null) }
    var loading by remember(hostId) { mutableStateOf(true) }
    var installConfirmTask by remember(hostId) { mutableStateOf<StartPlayResult.NeedInstall?>(null) }

    suspend fun reload() {
        runCatching { server.makeRequest<Host2.DetailVo>("host2/$hostId") }
            .onSuccess { response ->
                if (response.ok) detail = response.data ?: detail else message = response.msg
            }
            .onFailure { message = it.message ?: "无法加载房间信息" }
        loading = false
    }

    LaunchedEffect(hostId) {
        while (true) {
            reload()
            delay(2500)
        }
    }

    val current = detail
    MaxBox {
        ScreenContentSurface(ScreenContentSize.SMALL) {
            TitleRow(current?.name ?: "房间详情", onBack) {
                if (current?.status == HostStatus.STOPPED && current.packStatus == Host2PackStatus.Ok) {
                    CircleIconButton("\uF04B", "启动") {
                        scope.launch {
                            runCatching {
                                val response = server.makeRequest<Unit>("host2/$hostId/start", HttpMethod.Post)
                                if (!response.ok) throw RequestError(response.msg)
                            }.onFailure { message = it.message }
                        }
                    }
                } else if (current?.role in setOf(Role.OWNER, Role.ADMIN)) {
                    CircleIconButton("\uF04D", "停止") {
                        scope.launch {
                            runCatching {
                                val response = server.makeRequest<Unit>("host2/$hostId/stop", HttpMethod.Post)
                                if (!response.ok) throw RequestError(response.msg)
                            }.onFailure { message = it.message }
                        }
                    }
                    CircleIconButton("\uF01E", "重启") {
                        scope.launch {
                            runCatching {
                                val response = server.makeRequest<Unit>("host2/$hostId/restart", HttpMethod.Post)
                                if (!response.ok) throw RequestError(response.msg)
                            }.onFailure { message = it.message }
                        }
                    }
                }
                if (current?.status == HostStatus.PLAYABLE && onOpenPlay != null) {
                    CircleIconButton("\uF11B", "加入") {
                        scope.launch {
                            startHost2Play(hostId)
                                .onSuccess { result ->
                                    when (result) {
                                        is StartPlayResult.Ready -> onOpenPlay(result.args)
                                        is StartPlayResult.NeedInstall -> installConfirmTask = result
                                        is StartPlayResult.Installing -> {
                                            message = "整合包正在下载，请等待下载完成后再启动"
                                            onOpenTaskList(result.runId)
                                        }
                                        is StartPlayResult.NeedMod -> message =
                                            "房间缺少必要Mod：${result.modSlugs.joinToString("、")}"
                                    }
                                }
                                .onFailure { message = it.message }
                        }
                    }
                }
            }
            ContentBody {
                when {
                    loading -> Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) { CircularProgressIndicator() }
                    current == null -> Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                        Text(message ?: "无法加载房间信息", color = MaterialTheme.colorScheme.error)
                    }
                    else -> UnifiedHost2Overview(current, message)
                }
            }
        }
    }

    installConfirmTask?.let { pending ->
        AlertDialog(
            onDismissRequest = { installConfirmTask = null },
            title = { Text("安装整合包") },
            text = { Text("本地尚未安装房间所需的整合包，是否现在安装？") },
            confirmButton = {
                TextButton(onClick = {
                    runCatching {
                        ClientTaskManager.submit(pending.task, pending.dedupeKey)
                    }.onSuccess { runId ->
                        installConfirmTask = null
                        onOpenTaskList(runId)
                    }.onFailure { error ->
                        installConfirmTask = null
                        message = error.message ?: "提交整合包安装任务失败"
                    }
                }) { Text("安装") }
            },
            dismissButton = {
                TextButton(onClick = { installConfirmTask = null }) { Text("取消") }
            },
        )
    }
}

@Composable
private fun UnifiedHost2Overview(host: Host2.DetailVo, message: String?) {
    Column(
        modifier = Modifier.fillMaxSize(),
        verticalArrangement = Arrangement.spacedBy(12.dp),
    ) {
        message?.let { Text(it, color = MaterialTheme.colorScheme.error) }
        Text(host.intro)
        Text("${host.pack?.name ?: "整合包准备中"} ${host.pack?.versionName.orEmpty()}")
        Text("状态：${host.status.host2Text()} · 整合包：${host.packStatus}")
        if (host.pendingContentRevision != null) {
            Text("有待应用的内容更新（修订${host.pendingContentRevision}），启动或应用后生效")
        }
        Text("成员${host.members.size + 1}人")
        host.members.forEach { member ->
            val objectId = member.playerId.toObjectId().getOrNull()
            if (objectId != null) {
                calebxzhou.rdi.client.ui.comp.HeadButton(objectId, avatarSize = 28.dp, showName = true)
            } else {
                Text(member.playerId.toString())
            }
        }
    }
}

@Composable
fun UnifiedHost2ContentsScreen(
    target: HostTarget,
    onBack: () -> Unit,
    onOpenResourceMods: ((McVersion, ModLoader) -> Unit)? = null,
) {
    val hostId = target.id
    val scope = rememberCoroutineScope()
    var detail by remember(hostId) { mutableStateOf<Host2.DetailVo?>(null) }
    var contents by remember(hostId) { mutableStateOf<Host2.ContentsVo?>(null) }
    var loading by remember(hostId) { mutableStateOf(true) }
    var message by remember(hostId) { mutableStateOf<String?>(null) }

    fun reload() {
        scope.launch {
            loading = true
            runCatching {
                val detailResponse = server.makeRequest<Host2.DetailVo>("host2/$hostId")
                val contentsResponse = server.makeRequest<Host2.ContentsVo>("host2/$hostId/contents")
                if (!detailResponse.ok) throw RequestError(detailResponse.msg)
                if (!contentsResponse.ok) throw RequestError(contentsResponse.msg)
                detail = detailResponse.data
                contents = contentsResponse.data
            }.onFailure { message = it.message ?: "无法加载房间内容" }
            loading = false
        }
    }

    LaunchedEffect(hostId) { reload() }
    val currentDetail = detail
    val currentContents = contents
    val revision = currentContents?.pendingRevision ?: currentContents?.activeRevision ?: 0L
    val editingAllowed = currentDetail?.role in setOf(Role.OWNER, Role.ADMIN)

    MaxBox {
        ScreenContentSurface(ScreenContentSize.FULL) {
            TitleRow(currentDetail?.let { "${it.name} - 内容" } ?: "房间内容", onBack) {
                currentDetail?.pack?.let { pack ->
                    onOpenResourceMods?.let { callback ->
                        CircleIconButton("\uF067", "添加Mod") { callback(pack.mcVersion, pack.modLoader) }
                    }
                }
            }
            ContentBody {
                when {
                    loading -> Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) { CircularProgressIndicator() }
                    currentContents == null -> Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                        Text(message ?: "无法加载房间内容", color = MaterialTheme.colorScheme.error)
                    }
                    else -> Host2ContentsPane(
                        hostId = hostId,
                        contents = currentContents,
                        editingAllowed = editingAllowed,
                        canApply = currentDetail?.status == HostStatus.STOPPED,
                        onChanged = ::reload,
                        onError = { message = it },
                    )
                }
            }
        }
    }
}

@Composable
internal fun Host2ContentsPane(
    hostId: String,
    contents: Host2.ContentsVo,
    editingAllowed: Boolean,
    canApply: Boolean,
    onChanged: () -> Unit,
    onError: (String) -> Unit,
) {
    val scope = rememberCoroutineScope()
    val active = contents.active
    val pending = contents.pending
    val display = pending ?: active
    val gridItems = remember(display) { display.map(::toContentGridItem) }
    Column(Modifier.fillMaxSize(), verticalArrangement = Arrangement.spacedBy(8.dp)) {
        Row(horizontalArrangement = Arrangement.spacedBy(8.dp), verticalAlignment = Alignment.CenterVertically) {
            Text("当前修订${contents.activeRevision}")
            contents.pendingRevision?.let { Text("待应用${it}", color = MaterialTheme.colorScheme.primary) }
            if (contents.pendingRevision != null && editingAllowed) {
                TextButton(enabled = canApply, onClick = {
                    scope.launch {
                        runCatching {
                            val response = server.makeRequest<Host2.ContentRevisionVo>("host2/$hostId/contents/apply", HttpMethod.Post) {
                                contentType(io.ktor.http.ContentType.Application.Json)
                                setBody(serdesJson.encodeToString(Host2.ApplyContentsDto(contents.pendingRevision)))
                            }
                            if (!response.ok) throw RequestError(response.msg)
                        }.onSuccess { onChanged() }.onFailure { onError(it.message ?: "应用内容失败") }
                    }
                }) { Text(if (canApply) "应用更新" else "停止房间后应用") }
            }
        }
        if (pending != null) Text("运行中的房间会先保留待应用内容，停止后可应用。")
        ContentGrid(
            items = gridItems,
            modifier = Modifier.fillMaxSize(),
            showTypeFilters = true,
            onSelectionChange = { item, enabled ->
                if (!editingAllowed) return@ContentGrid
                val source = display.firstOrNull { it.contentGridKey() == item.key } ?: return@ContentGrid
                scope.launch {
                    runCatching {
                        val response = server.makeRequest<Host2.ContentRevisionVo>("host2/$hostId/contents/enabled", HttpMethod.Put) {
                            contentType(io.ktor.http.ContentType.Application.Json)
                            setBody(serdesJson.encodeToString(Host2.SetContentsEnabledDto(
                                expectedRevision = contents.pendingRevision ?: contents.activeRevision,
                                keys = listOf(ContentKey(source.origin, source.platform, source.projectId)),
                                enabled = enabled,
                            )))
                        }
                        if (!response.ok) throw RequestError(response.msg)
                    }.onSuccess { onChanged() }.onFailure { onError(it.message ?: "更新内容失败") }
                }
            },
            onDelete = { item ->
                if (!editingAllowed) return@ContentGrid
                val source = display.firstOrNull { it.contentGridKey() == item.key } ?: return@ContentGrid
                if (source.origin != ContentOrigin.Extra) return@ContentGrid
                scope.launch {
                    runCatching {
                        val response = server.makeRequest<Host2.ContentRevisionVo>("host2/$hostId/contents", HttpMethod.Delete) {
                            contentType(io.ktor.http.ContentType.Application.Json)
                            setBody(serdesJson.encodeToString(Host2.DeleteContentsDto(
                                expectedRevision = contents.pendingRevision ?: contents.activeRevision,
                                keys = listOf(ContentKey(source.origin, source.platform, source.projectId)),
                            )))
                        }
                        if (!response.ok) throw RequestError(response.msg)
                    }.onSuccess { onChanged() }.onFailure { onError(it.message ?: "删除内容失败") }
                }
            },
            canDelete = { item ->
                editingAllowed && display.firstOrNull { it.contentGridKey() == item.key }?.origin == ContentOrigin.Extra
            },
        )
    }
}

private fun toContentGridItem(content: ContentVo): ContentGridItem.ContentItem =
    ContentGridItem.ContentItem(
        key = content.contentGridKey(),
        type = when (content.type) {
            ContentType.Mod -> ContentGridType.MOD
            ContentType.ShaderPack -> ContentGridType.SHADER_PACK
            ContentType.ResPack -> ContentGridType.RESOURCE_PACK
            ContentType.DataPack -> ContentGridType.DATA_PACK
            ContentType.Other -> ContentGridType.OTHER
        },
        name = content.slug,
        fileName = content.targetPath ?: content.slug,
        targetPath = content.targetPath.orEmpty(),
        required = content.required,
        selectionState = if (content.enabled) calebxzhou.rdi.client.ui.comp.ContentSelectionState.SELECTED
        else calebxzhou.rdi.client.ui.comp.ContentSelectionState.UNSELECTED,
        status = "${content.platform} · ${content.side}",
    )

private fun ContentVo.contentGridKey(): String = "$origin:$platform:$projectId"

private fun HostStatus.host2Text(): String = when (this) {
    HostStatus.STARTED -> "启动中"
    HostStatus.PLAYABLE -> "可游玩"
    HostStatus.STOPPED -> "已停止"
    HostStatus.PAUSED -> "已暂停"
    HostStatus.UNKNOWN -> "未知"
}

@Composable
fun UnifiedHost2SettingsScreen(
    target: HostTarget,
    onBack: () -> Unit,
) {
    val id = target.id
    val scope = rememberCoroutineScope()
    var detail by remember(id) { mutableStateOf<Host2.DetailVo?>(null) }
    var name by remember(id) { mutableStateOf("") }
    var intro by remember(id) { mutableStateOf("") }
    var iconUrl by remember(id) { mutableStateOf("") }
    var whitelist by remember(id) { mutableStateOf(true) }
    var loading by remember(id) { mutableStateOf(true) }
    var saving by remember(id) { mutableStateOf(false) }
    var error by remember(id) { mutableStateOf<String?>(null) }
    LaunchedEffect(id) {
        runCatching {
            val response = server.makeRequest<Host2.DetailVo>("host2/$id")
            if (!response.ok) throw RequestError(response.msg)
            response.data?.also {
                detail = it
                name = it.name
                intro = it.intro
                iconUrl = it.iconUrl.orEmpty()
                whitelist = it.whitelist
            }
        }.onFailure { error = it.message ?: "无法加载房间设置" }
        loading = false
    }
    MaxBox {
        ScreenContentSurface(ScreenContentSize.MEDIUM) {
            TitleRow("房间设置", onBack)
            ScrollableContentBody {
                if (loading) CircularProgressIndicator()
                else Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
                    OutlinedTextField(name, { name = it }, label = { Text("房间名称") }, singleLine = true, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(intro, { intro = it }, label = { Text("简介") }, modifier = Modifier.fillMaxWidth())
                    OutlinedTextField(iconUrl, { iconUrl = it }, label = { Text("图标URL") }, singleLine = true, modifier = Modifier.fillMaxWidth())
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Checkbox(whitelist, { whitelist = it })
                        Text("仅成员可加入")
                    }
                    error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
                    Button(enabled = !saving && detail != null, onClick = {
                        saving = true
                        scope.launch {
                            runCatching {
                                val response = server.makeRequest<Unit>("host2/$id/options", HttpMethod.Put) {
                                    json()
                                    setBody(Host2.OptionsDto(name = name.trim(), intro = intro, iconUrl = iconUrl, whitelist = whitelist))
                                }
                                if (!response.ok) throw RequestError(response.msg)
                            }.onSuccess { onBack() }.onFailure { error = it.message ?: "保存失败" }
                            saving = false
                        }
                    }) { Text(if (saving) "保存中" else "保存") }
                }
            }
        }
    }
}
