import calebxzhou.rdi.client.service.toContentGridItems
import calebxzhou.rdi.client.ui.comp.ConsoleState
import calebxzau.rdi.client.ui.viewmodel.resolvedModsForTest
import calebxzau.rdi.client.modcatalog.CatalogContentType
import calebxzau.rdi.client.modcatalog.CatalogDigest
import calebxzau.rdi.client.modcatalog.CatalogDigestAlgorithm
import calebxzau.rdi.client.modcatalog.CatalogFile
