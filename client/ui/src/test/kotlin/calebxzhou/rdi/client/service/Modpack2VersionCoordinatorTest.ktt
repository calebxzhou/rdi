package calebxzhou.rdi.client.service

import kotlinx.coroutines.async
import kotlinx.coroutines.CompletableDeferred
import kotlinx.coroutines.delay
import kotlinx.coroutines.runBlocking
import kotlin.test.Test
import kotlin.test.assertEquals
import kotlin.uuid.Uuid

class Modpack2VersionCoordinatorTest {
    @Test
    fun `same version operations are serialized`() = runBlocking {
        val coordinator = Modpack2VersionCoordinator()
        val versionId = Uuid.parse("019f2d68-6b7e-7ec8-98d1-0b8483c39875")
        val events = mutableListOf<String>()
        val firstEntered = CompletableDeferred<Unit>()

        val first = async {
            coordinator.withLock(versionId) {
                events += "first-start"
                firstEntered.complete(Unit)
                delay(25)
                events += "first-end"
            }
        }
        firstEntered.await()
        val second = async {
            coordinator.withLock(versionId) { events += "second" }
        }
        first.await()
        second.await()

        assertEquals(listOf("first-start", "first-end", "second"), events)
    }
}
