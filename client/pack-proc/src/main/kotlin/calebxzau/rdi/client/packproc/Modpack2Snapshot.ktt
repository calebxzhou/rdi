package calebxzau.rdi.client.packproc

import calebxzhou.rdi.common.archive.extractArchiveToDir
import calebxzhou.rdi.common.archive.listArchiveEntries
import calebxzhou.rdi.common.util.deleteRecursivelyNoSymlink
import calebxzhou.rdi.common.util.digestHex
import calebxzhou.rdi.common.util.sha1dig
import java.io.File
import java.io.FileInputStream
import java.nio.charset.StandardCharsets
import java.nio.file.Files
import java.nio.file.LinkOption
import java.security.MessageDigest

internal object Modpack2SnapshotHasher {
    fun scan(rootDir: File, sourceName: String = rootDir.name): Modpack2PackPreview {
        require(rootDir.isDirectory) { "Modpack2来源不是目录: ${rootDir.path}" }
        val root = rootDir.toPath().toAbsolutePath().normalize()
        val files = mutableListOf<Modpack2SnapshotFile>()
        Files.walk(root).use { paths ->
            paths.forEach { path ->
                if (path == root) return@forEach
                if (Files.isSymbolicLink(path)) {
                    throw IllegalArgumentException("Modpack2来源不允许符号链接: ${root.relativize(path)}")
                }
                if (!Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)) return@forEach
                val relative = normalizePackPath(root.relativize(path).toString())
                require(isSafePackPath(relative)) { "Modpack2来源路径无效: $relative" }
                val file = path.toFile()
                files += Modpack2SnapshotFile(
                    relativePath = relative,
                    file = file,
                    sha1 = sha1(file),
                    size = file.length(),
                )
            }
        }
        val sorted = files.sortedBy { it.relativePath }
        return Modpack2PackPreview(
            sourceName = sourceName,
            fingerprint = fingerprint(sorted),
            files = sorted,
        )
    }

    fun fingerprint(files: List<Modpack2SnapshotFile>): String {
        val digest = MessageDigest.getInstance("SHA-256")
        files.sortedBy { it.relativePath }.forEach { file ->
            digest.update(file.relativePath.toByteArray(StandardCharsets.UTF_8))
            digest.update(0.toByte())
            digest.update(file.sha1.lowercase().toByteArray(StandardCharsets.US_ASCII))
            digest.update(0.toByte())
            digest.update(file.size.toString().toByteArray(StandardCharsets.US_ASCII))
            digest.update('\n'.code.toByte())
        }
        return digest.digest().toHex()
    }

    fun sha1(file: File): String {
        val digest = sha1dig()
        FileInputStream(file).buffered().use { input ->
            val buffer = ByteArray(DEFAULT_BUFFER_SIZE)
            while (true) {
                val count = input.read(buffer)
                if (count <= 0) break
                digest.update(buffer, 0, count)
            }
        }
        return digest.digestHex()
    }

    fun copyDirectory(source: File, target: File, excludedSourceDir: File? = null) {
        val sourcePath = source.toPath().toAbsolutePath().normalize()
        val targetPath = target.toPath().toAbsolutePath().normalize()
        val excludedPath = excludedSourceDir?.toPath()?.toAbsolutePath()?.normalize()
            ?.takeIf { it != sourcePath && it.startsWith(sourcePath) }
        Files.createDirectories(targetPath)
        Files.walk(sourcePath).use { paths ->
            paths
                .filter { path -> excludedPath == null || path != excludedPath && !path.startsWith(excludedPath) }
                .forEach { path ->
                    if (Files.isSymbolicLink(path)) {
                        throw IllegalArgumentException("Modpack2来源不允许符号链接: ${sourcePath.relativize(path)}")
                    }
                    val relative = sourcePath.relativize(path)
                    val destination = targetPath.resolve(relative.toString()).normalize()
                    require(destination.startsWith(targetPath)) { "Modpack2来源路径越界: $relative" }
                    if (Files.isDirectory(path, LinkOption.NOFOLLOW_LINKS)) {
                        Files.createDirectories(destination)
                    } else if (Files.isRegularFile(path, LinkOption.NOFOLLOW_LINKS)) {
                        Files.createDirectories(destination.parent)
                        Files.copy(path, destination)
                    }
                }
        }
    }

    fun materialize(source: File, target: File, excludedSourceDir: File? = null) {
        require(source.exists()) { "找不到Modpack2来源: ${source.path}" }
        if (source.isDirectory) {
            copyDirectory(source, target, excludedSourceDir)
            return
        }
        val entries = listArchiveEntries(source)
        val normalized = entries.map { normalizePackPath(it.path) }
        require(normalized.size == normalized.toSet().size) { "Modpack2归档包含重复路径" }
        require(normalized.all(::isSafePackPath)) { "Modpack2归档包含非法路径" }
        Files.createDirectories(target.toPath())
        extractArchiveToDir(source, target)
    }

    fun isSafePackPath(path: String): Boolean {
        val normalized = path.replace('\\', '/')
        if (normalized.isBlank() || normalized.startsWith('/') || Regex("^[A-Za-z]:").containsMatchIn(normalized)) {
            return false
        }
        val parts = normalized.split('/')
        return parts.none { it.isBlank() || it == "." || it == ".." }
    }

    private fun ByteArray.toHex(): String = joinToString("") { "%02x".format(it) }
}

internal fun ByteArray.toHexDigest(): String = joinToString("") { "%02x".format(it) }
